{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "exclude": ["webview", "dist", "node_modules"]
}
